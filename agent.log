        return []


def query_portfolio_constructor_agent(
    buy_candidates, macro_directives, regime,
    portfolio, total_nav, earnings_landmines
):
    """AGENT 3 — Selects new position entries. Cannot issue SELL/TRIM orders."""
    if not regime.get('new_buys_allowed', True):
        log_and_print(f"{YELLOW}[Constructor Agent] BEAR REGIME: all new buys blocked.{RESET}")
        return []

    # Pre-filter: remove earnings landmines
    safe = {k: v for k, v in buy_candidates.items() if k not in earnings_landmines}

    # Pre-filter: remove sectors the macro agent wants to underweight
    avoid_sectors = set(macro_directives.get("sectors_to_underweight", []))
    if avoid_sectors:
        safe = {k: v for k, v in safe.items() if v.get('sector', '') not in avoid_sectors}

    if not safe:
        log_and_print(f"{YELLOW}[Constructor Agent] No safe candidates after filters.{RESET}")
        return []

    # Attach ATR-based sizing to each candidate
    for tkr in safe:
        sizing = calculate_position_size(tkr, total_nav, regime)
        safe[tkr]["recommended_position_value"] = sizing.get("recommended_value", total_nav * 0.05)
        safe[tkr]["atr14"]          = sizing.get("atr14", "N/A")
        safe[tkr]["implied_stop"]   = sizing.get("implied_stop", "N/A")

    prompt = f"""
You are a Portfolio Constructor at a conviction-driven growth fund.
Select 2–4 highest-conviction buys from the pre-screened candidates below.

MACRO DIRECTIVE:     {macro_directives.get('positioning_bias', 'NEUTRAL')}
OVERWEIGHT SECTORS:  {macro_directives.get('sectors_to_overweight', [])}
AVAILABLE CASH:      ${round(portfolio['cash_balance'], 2)}
PORTFOLIO NAV:       ${round(total_nav, 2)}
REGIME:              {regime.get('regime', 'UNKNOWN')}
EARNINGS BLOCKED:    {list(earnings_landmines.keys())}
EXISTING POSITIONS:  {list(portfolio.get('positions', {}).keys())}

SCREENED CANDIDATES (pre-scored, pre-sized by ATR):
{json.dumps(safe, indent=2)}

Use 'recommended_position_value' as baseline sizing.
Prioritize tickers tagged GENERATIONAL_200W_EMA.
Do NOT exceed available cash across all orders combined.

Output ONLY valid JSON (no markdown fences):
{{
  "buy_orders": [
    {{
      "action": "BUY",
      "ticker": "NOW",
      "strategy_bucket": "LONG_TERM_CORE",
      "transaction_value_usd": 7500,
      "position_action_percentage": 100,
      "analysis_display": "Conviction rationale citing specific metrics."
    }}
  ]
}}
"""
    try:
        r = ai_client.models.generate_content(
            model=GEMINI_MODEL,
            contents=prompt,
            config=types.GenerateContentConfig(temperature=0.15)
        )
        raw  = r.text.replace("```json", "").replace("```", "").strip()
        data = json.loads(raw)
        return data.get("buy_orders", [])

    except Exception as e:
        log_and_print(f"{RED}[Constructor Agent Error] {e}{RESET}")
        return []


# ==========================================
# EXECUTION ENGINE
# ==========================================
def consolidate_decisions(decisions):
    consolidated = {}
    for d in decisions:
        ticker = d.get("ticker", "").upper()
        action = d.get("action", "").upper()
        bucket = d.get("strategy_bucket", "MACRO_SWING").upper()
        if not ticker or action == "HOLD":
            continue
        if action == "BUY":
            key = f"{ticker}_BUY_{bucket}"
            if key not in consolidated:
                consolidated[key] = d
            else:
                consolidated[key]["transaction_value_usd"] = (
                    float(consolidated[key].get("transaction_value_usd", 0))
                    + float(d.get("transaction_value_usd", 0))
                )
        else:
            key = f"{ticker}_{action}_{bucket}_{len(consolidated)}"
            consolidated[key] = d
    return list(consolidated.values())


def execute_trades(decisions, portfolio, buy_candidates, risk_matrix, total_nav, regime):
    if not decisions:
        log_and_print(f"{YELLOW}[⚠] No trades ordered.{RESET}")
        return

    CASH_FLOOR  = total_nav * regime.get('cash_floor_pct', 0.04)
    MAX_POS     = total_nav * regime.get('max_pos_pct', 0.12)

    for d in decisions:
        action    = d.get("action", "").upper()
        ticker    = d.get("ticker", "").upper()
        value     = float(d.get("transaction_value_usd", 0))
        pct_trim  = float(d.get("position_action_percentage", 0))
        bucket    = d.get("strategy_bucket", "MACRO_SWING").upper()
        rationale = d.get("analysis_display", "")

        if action == "HOLD":
            continue

        elif action in ["SELL", "TRIM"]:
            target = f"{ticker}_{bucket}"
            keys = ([target] if target in portfolio["positions"]
                    else [pk for pk in portfolio["positions"] if pk.startswith(ticker)])

            for pk in list(keys):
                pos = portfolio["positions"].get(pk)
                if not pos:
                    continue
                cp = risk_matrix.get(pk, {}).get("current_price", pos["entry_price"])

                if action == "SELL":
                    reclaimed = pos["shares"] * cp
                    portfolio["cash_balance"] += reclaimed
                    del portfolio["positions"][pk]
                    msg = (f"🔴 *LIQUIDATION: {ticker}*\n"
                           f"Reclaimed: ${round(reclaimed,2)}\n{rationale}")
                    log_and_print(f"{RED}{msg}{RESET}"); send_notification(msg)

                elif action == "TRIM":
                    pos_val = pos["shares"] * cp
                    if pct_trim > 0:
                        trim_amt = pos_val * (pct_trim / 100.0)
                    else:
                        trim_amt   = min(value, pos_val)
                        pct_trim   = (trim_amt / pos_val * 100) if pos_val > 0 else 0

                    portfolio["cash_balance"] += trim_amt
                    pos["shares"]            -= trim_amt / cp
                    pos["allocated_capital"]  = pos["shares"] * pos["entry_price"]

                    if pos["shares"] <= 0.0001:
                        del portfolio["positions"][pk]

                    msg = (f"🟠 *TRIM: {ticker}*\n"
                           f"{round(pct_trim,1)}% cut | "
                           f"${round(trim_amt,2)} reclaimed\n{rationale}")
                    log_and_print(f"{YELLOW}{msg}{RESET}"); send_notification(msg)

        elif action == "BUY":
            if ticker not in buy_candidates:
                log_and_print(f"{YELLOW}[⚠] {ticker} not in screened candidates — skipping.{RESET}")
                continue

            avail = portfolio["cash_balance"] - CASH_FLOOR
            if avail <= 0:
                log_and_print(f"{YELLOW}[⚠] Cash floor reached — no buy.{RESET}")
                continue

            value = min(value, avail)

            existing = sum(
                p["allocated_capital"]
                for pk, p in portfolio["positions"].items()
                if pk.startswith(ticker)
            )
            if existing + value > MAX_POS:
                value = max(0.0, MAX_POS - existing)

            if value <= 500:
                continue

            cp      = buy_candidates[ticker]["price"]
            shares  = value / cp
            pos_key = f"{ticker}_{bucket}"

            portfolio["cash_balance"] -= value

            if pos_key in portfolio["positions"]:
                old = portfolio["positions"][pos_key]
                new_cap    = old["allocated_capital"] + value
                new_shares = old["shares"] + shares
                portfolio["positions"][pos_key].update({
                    "shares":           new_shares,
                    "allocated_capital": new_cap,
                    "entry_price":      new_cap / new_shares,
                    "high_watermark":   max(old.get("high_watermark", 0), cp),
                })
            else:
                portfolio["positions"][pos_key] = {
                    "entry_price":       cp,
                    "shares":            shares,
                    "allocated_capital": value,
                    "strategy_bucket":   bucket,
                    "purchase_date":     datetime.now(ZoneInfo("America/New_York")).strftime('%Y-%m-%d'),
                    "buying_thesis":     rationale,
                    "high_watermark":    cp,   # UPGRADE #7: trailing stop seed
                }

            msg = (f"🟢 *ACQUISITION: {ticker}*\n"
                   f"Setup: {buy_candidates[ticker].get('setup_type','Standard')}\n"
                   f"${round(value,2)} @ ${round(cp,2)}\n{rationale}")
            log_and_print(f"{GREEN}{msg}{RESET}"); send_notification(msg)

    save_portfolio(portfolio)


