def send_notification(message):
    if not TELEGRAM_BOT_TOKEN or "YOUR_" in TELEGRAM_BOT_TOKEN:
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    try:
        requests.post(
            url,
            json={"chat_id": TELEGRAM_CHAT_ID, "text": message, "parse_mode": "Markdown"},
            timeout=10
        )
    except Exception as e:
        log_and_print(f"Telegram failed: {e}")


# ==========================================
# 3. UNIVERSE
# ==========================================
def get_macro_universe():
    tickers = set()
    log_and_print(f"{CYAN}[🌐 Universe] Compiling macro universe...{RESET}")
    headers = {'User-Agent': 'Mozilla/5.0'}

    try:
        res = requests.get(
            'https://en.wikipedia.org/wiki/List_of_S%26P_500_companies',
            headers=headers, timeout=15
        )
        tickers.update(pd.read_html(res.text)[0]['Symbol'].tolist())
    except Exception as e:
        log_and_print(f"Warning: S&P 500 fetch failed: {e}")

    try:
        res = requests.get('https://en.wikipedia.org/wiki/Nasdaq-100', headers=headers, timeout=15)
        tables = pd.read_html(res.text, match='Ticker|Symbol')
        col = 'Ticker' if 'Ticker' in tables[0].columns else 'Symbol'
        tickers.update(tables[0][col].tolist())
    except Exception as e:
        log_and_print(f"Warning: Nasdaq 100 fetch failed: {e}")

    strategic_alpha = [
        "NOW", "SHOP", "AXON", "SNOW", "CRM", "PLTR", "AMD", "QCOM", "MU",
        "ZETA", "COIN", "HOOD", "VST", "CELH", "AVGO", "MSFT", "LLY", "MELI",
        "NU", "APP", "TMDX", "RDDT", "ARM"
    ]
    tickers.update(strategic_alpha)

    cleaned = [str(t).replace('.', '-') for t in tickers if isinstance(t, str)]
    log_and_print(f"{CYAN}[🌐 Universe] Total equities: {len(cleaned)}{RESET}")
    return list(set(cleaned))


# ==========================================
# UPGRADE #3 — MULTI-FACTOR MACRO REGIME
# ==========================================
def check_enhanced_market_regime():
    """
    Five-factor macro regime model (vs single SPY drawdown in v1):

    Factor 1 — SPY drawdown from 60-day high    (0-30 pts)
    Factor 2 — VIX absolute level               (0-30 pts)
    Factor 3 — Yield curve 2Y-10Y spread        (0-20 pts)  ← recession signal
    Factor 4 — Credit spread proxy HYG vs IEF   (0-20 pts)  ← risk appetite
    Factor 5 — Market breadth (MMTH)            (0-20 pts)  ← participation

    Risk Score 0–29  → BULL  : 4% cash floor, 12% max position
    Risk Score 30–59 → CAUTION: 15% cash floor, 8% max position
    Risk Score 60+   → BEAR  : 40% cash floor, 5% max position, no new buys
    """
    log_and_print(f"{CYAN}[🔍 Regime] Running multi-factor macro assessment...{RESET}")
    risk_score = 0
    signals = {}

    # Factor 1: SPY drawdown
    try:
        spy = yf.Ticker("^GSPC").history(period="60d")
        if not spy.empty:
            dd = ((spy['High'].max() - spy['Close'].iloc[-1]) / spy['High'].max()) * 100
            signals['spy_drawdown_pct'] = round(dd, 2)
            if dd >= 10:
                risk_score += 30
            elif dd >= 5:
                risk_score += 15
    except Exception as e:
        log_and_print(f"Warning: SPY regime: {e}")

    # Factor 2: VIX
    try:
        vix_hist = yf.Ticker("^VIX").history(period="30d")
        if not vix_hist.empty:
            vix = float(vix_hist['Close'].iloc[-1])
            signals['vix'] = round(vix, 2)
            signals['vix_spiking'] = vix > float(vix_hist['Close'].mean()) * 1.20
            if vix >= 35:
                risk_score += 30
            elif vix >= 25:
                risk_score += 20
            elif vix >= 18:
                risk_score += 8
    except Exception as e:
        log_and_print(f"Warning: VIX: {e}")

    # Factor 3: Yield curve (10Y minus 5Y as proxy for 2-10 spread)
    try:
        t10 = yf.Ticker("^TNX").history(period="5d")
        t5  = yf.Ticker("^FVX").history(period="5d")
        if not t10.empty and not t5.empty:
            spread = float(t10['Close'].iloc[-1]) - float(t5['Close'].iloc[-1])
            signals['yield_spread_10y_5y'] = round(spread, 3)
            signals['yield_curve_inverted'] = spread < 0
            if spread < -0.50:
                risk_score += 20
            elif spread < 0:
                risk_score += 10
    except Exception as e:
        log_and_print(f"Warning: Yield curve: {e}")

    # Factor 4: Credit spread proxy (HYG vs IEF 30-day return delta)
    try:
        hyg = yf.Ticker("HYG").history(period="30d")['Close']
        ief = yf.Ticker("IEF").history(period="30d")['Close']
        delta = (hyg.iloc[-1]/hyg.iloc[0] - 1)*100 - (ief.iloc[-1]/ief.iloc[0] - 1)*100
        signals['credit_signal_30d'] = round(delta, 2)
        if delta < -5:
            risk_score += 20
        elif delta < -2:
            risk_score += 10
    except Exception as e:
        log_and_print(f"Warning: Credit spreads: {e}")

    # Factor 5: Market breadth — % of S&P 500 above their 200DMA
    try:
        mmth = yf.Ticker("^MMTH").history(period="10d")
        if not mmth.empty:
            breadth = float(mmth['Close'].iloc[-1])
            signals['pct_above_200d'] = round(breadth, 1)
            if breadth < 30:
                risk_score += 20
            elif breadth < 50:
                risk_score += 10
    except Exception as e:
        log_and_print(f"Warning: Breadth: {e}")

    # Classification
    if risk_score >= 60:
        regime, cash_floor, max_pos, buys_ok = "BEAR",    0.40, 0.05, False
    elif risk_score >= 30:
        regime, cash_floor, max_pos, buys_ok = "CAUTION", 0.15, 0.08, True
    else:
        regime, cash_floor, max_pos, buys_ok = "BULL",    0.04, 0.12, True

    result = {
        "regime":           regime,
        "risk_score":       risk_score,
        "signals":          signals,
        "cash_floor_pct":   cash_floor,
        "max_pos_pct":      max_pos,
        "new_buys_allowed": buys_ok,
    }
    log_and_print(
        f"{CYAN}[🔍 Regime] {regime} | Score: {risk_score}/120 | "
        f"Cash floor: {int(cash_floor*100)}% | Max pos: {int(max_pos*100)}%{RESET}"
    )
    return result


# ==========================================
# UPGRADE #2 — ENHANCED MULTI-FACTOR SCREENER
# ==========================================
def run_enhanced_screener(tickers):
    """
    SUPER INVESTOR GRADE MULTI-FACTOR MODEL
    ========================================

    TECHNICAL (58pts max)
    ├── 200-Week EMA support zone (+50) — "generational buy" signal
    ├── Above 200-Day SMA fallback   (+15)
    └── OBV rising (institutional accumulation) (+8)

    QUALITY (35pts max)  — Warren Buffett / Joel Greenblatt
    ├── ROE >= 25%           (+12)
    ├── FCF Yield >= 4%      (+10)  ← owner earnings, Buffett's preferred metric
    ├── Gross Margin >= 50%  (+8)
    └── ROIC >= 15%          (+5)   ← Magic Formula #1 factor

    GROWTH (20pts max)
    ├── Revenue Growth >= 20% YoY  (+12)
    └── Analyst consensus upside >= 15% (+8)  ← estimate revision momentum

    MOMENTUM (18pts max) — James O'Shaughnessy
    ├── 6M Relative Strength vs SPY > +5%   (+10)
    └── 12M Relative Strength vs SPY > +10% (+8)

    VALUE (12pts max) — Peter Lynch
    ├── PEG Ratio <= 1.5  (+8)  ← Lynch's core metric
    └── EV/EBITDA <= 25   (+4)

    MINIMUM QUALIFYING SCORE: 55 / 143
    """
    log_and_print(f"{CYAN}[⚙️ Screener] Running super investor multi-factor model...{RESET}")

    # Pre-fetch SPY for relative strength calculations
    try:
        spy = yf.Ticker("SPY").history(period="1y")['Close']
        spy_6m  = (spy.iloc[-1] / spy.iloc[-126] - 1) * 100
        spy_12m = (spy.iloc[-1] / spy.iloc[0]   - 1) * 100
    except Exception:
        spy_6m = spy_12m = 0.0

    candidates = {}

    for ticker in tickers:
        try:
            t = yf.Ticker(ticker)
            hist_d = t.history(period="1y")
            hist_w = t.history(period="5y", interval="1wk")
            info   = t.info

            if hist_d.empty or len(hist_d) < 200 or hist_w.empty:
                continue

            closes_d = hist_d['Close']
            closes_w = hist_w['Close'].dropna()
            price    = float(closes_d.iloc[-1])

            # ── Hard Quality Gate ─────────────────────────────────────────
            roe      = info.get('returnOnEquity')  or 0
            op_cash  = info.get('operatingCashflow') or 0
            rev_growth = info.get('revenueGrowth') or 0

            if roe < 0.12 or op_cash <= 0 or rev_growth <= 0:
                continue

            # ── Quality Factors ──────────────────────────────────────────
            mktcap      = info.get('marketCap')    or 0
            fcf         = info.get('freeCashflow') or 0
            gross_margin = info.get('grossMargins') or 0
            roic        = info.get('returnOnCapitalEmployed') or 0
            fcf_yield   = (fcf / mktcap) if mktcap > 0 else 0

            # ── Growth Factors ───────────────────────────────────────────
            target_price = info.get('targetMeanPrice') or 0
            analyst_up   = ((target_price - price) / price * 100) if target_price > 0 else 0

            # ── Value Factors ────────────────────────────────────────────
            peg      = info.get('pegRatio') or 0
            ev_ebitda = info.get('enterpriseToEbitda') or 0

            # ── Momentum Factors ─────────────────────────────────────────
            ret_6m  = (price / float(closes_d.iloc[-126]) - 1) * 100 if len(closes_d) >= 126 else 0
            ret_12m = (price / float(closes_d.iloc[0])   - 1) * 100
            rs_6m   = ret_6m  - spy_6m
            rs_12m  = ret_12m - spy_12m

            # ── Technical Factors ────────────────────────────────────────
            sma_200d = float(closes_d.iloc[-200:].mean())
            if len(closes_w) < 200:
                continue
            ema_200w     = float(closes_w.ewm(span=200, adjust=False).mean().iloc[-1])
            price_to_ema = price / ema_200w

            # On-Balance Volume trend
            vol = hist_d['Volume']
            obv = (np.sign(closes_d.diff()) * vol).cumsum()
            obv_rising = float(obv.iloc[-20:].mean()) > float(obv.iloc[-50:].mean())

            # ── Scoring ──────────────────────────────────────────────────
            score = 0
            tags  = []

            # Technical
            if 0.98 <= price_to_ema <= 1.04:
                score += 50; tags.append("🏆 GENERATIONAL_200W_EMA")
            elif price > sma_200d:
                score += 15; tags.append("ABOVE_200D_SMA")
            if obv_rising:
                score += 8;  tags.append("INST_ACCUMULATION")

            # Quality
            if roe >= 0.25:      score += 12; tags.append("HIGH_ROE")
            elif roe >= 0.15:    score += 6
            if fcf_yield >= 0.04: score += 10; tags.append("STRONG_FCF_YIELD")
            elif fcf_yield >= 0.02: score += 5
            if gross_margin >= 0.50: score += 8; tags.append("PREMIUM_MARGINS")
            elif gross_margin >= 0.35: score += 4
            if roic >= 0.15:     score += 5;  tags.append("HIGH_ROIC")

            # Growth
            if rev_growth >= 0.20: score += 12; tags.append("HIGH_REV_GROWTH")
            elif rev_growth >= 0.10: score += 6
            if analyst_up >= 15:   score += 8;  tags.append("ANALYST_UPGRADES")
            elif analyst_up >= 5:   score += 4

            # Momentum
            if rs_6m  >= 5:   score += 10; tags.append("STRONG_RS_6M")
            if rs_12m >= 10:  score += 8;  tags.append("STRONG_RS_12M")

            # Value
            if 0 < peg <= 1.5:     score += 8; tags.append("ATTRACTIVE_PEG")
            elif 0 < peg <= 2.5:   score += 4
            if 0 < ev_ebitda <= 25: score += 4

            if score >= 55:
                candidates[ticker] = {
                    "price":             round(price, 2),
                    "score":             score,
                    "setup_type":        " | ".join(tags),
                    "sector":            info.get('sector', 'Unknown'),
                    "weekly_ema_200":    round(ema_200w, 2),
                    "roe_pct":           round(roe * 100, 2),
                    "roic_pct":          round(roic * 100, 2),
                    "fcf_yield_pct":     round(fcf_yield * 100, 2),
                    "gross_margin_pct":  round(gross_margin * 100, 2),
                    "rev_growth_pct":    round(rev_growth * 100, 2),
                    "peg_ratio":         round(peg, 2) if peg else "N/A",
                    "analyst_upside_pct": round(analyst_up, 1),
                    "rs_6m_vs_spy":      round(rs_6m, 2),
                    "rs_12m_vs_spy":     round(rs_12m, 2),
                    "inst_accumulation": obv_rising,
                }

            time.sleep(0.05)

        except Exception:
            continue

    log_and_print(f"{CYAN}[⚙️ Screener] Qualified: {len(candidates)}{RESET}")
    return dict(
        sorted(candidates.items(), key=lambda x: x[1]['score'], reverse=True)[:15]
    )


# ==========================================
# UPGRADE #4 — ATR-BASED POSITION SIZING
# ==========================================
def calculate_position_size(ticker, portfolio_nav, regime, risk_pct=0.01):
    """
    Volatility-Adjusted Sizing (Van Tharp / institutional standard)
    ================================================================
    Dollar Risk  = NAV × risk_pct  (default 1% — lose at most 1% NAV on a stop)
    ATR Stop     = ATR(14) × 2.0
    Shares       = Dollar Risk / ATR Stop
    Position $   = Shares × Price

    Then capped at regime['max_pos_pct'] of NAV.

    Effect: A high-beta stock like NVDA gets a smaller position than
    a low-volatility name like MSFT for the same dollar risk budget.
    This is how Renaissance, Bridgewater, and DE Shaw size positions.
    """
    try:
        hist = yf.Ticker(ticker).history(period="60d")
        if hist.empty or len(hist) < 14:
            raise ValueError("Insufficient history")

        high = hist['High']
        low  = hist['Low']
        prev = hist['Close'].shift(1)

        tr = pd.concat([
            high - low,
            (high - prev).abs(),
            (low  - prev).abs()
        ], axis=1).max(axis=1)

        atr14 = float(tr.iloc[-14:].mean())
        price = float(hist['Close'].iloc[-1])

        dollar_risk    = portfolio_nav * risk_pct
        stop_distance  = atr14 * 2.0
        shares         = dollar_risk / stop_distance if stop_distance > 0 else 0
        position_value = shares * price

        cap = portfolio_nav * regime.get('max_pos_pct', 0.10)
        final = min(position_value, cap)

        return {
            "recommended_value": round(final, 2),
            "atr14":             round(atr14, 2),
            "atr_pct":           round(atr14 / price * 100, 2),
            "implied_stop":      round(price - (atr14 * 2), 2),
            "method":            "ATR_ADJUSTED",
        }
    except Exception:
        return {
            "recommended_value": round(portfolio_nav * 0.05, 2),
            "method":            "FALLBACK_5PCT",
        }


# ==========================================
# UPGRADE #5 — EARNINGS CALENDAR GUARD
# ==========================================
def get_earnings_landmines(tickers, days_ahead=14):
    """
    Peter Lynch: "Never buy a stock for its next quarter's earnings."
    Blocks new position entries within 14 days of an earnings event.
    Also flags stocks that just reported (gap risk from revisions).
    """
    landmines = {}
    for ticker in tickers:
        try:
            cal = yf.Ticker(ticker).calendar
            if cal is None:
                continue

            # yfinance returns different structures by version
            if hasattr(cal, 'index') and 'Earnings Date' in cal.index:
                dt = cal.loc['Earnings Date'].iloc[0]
            elif isinstance(cal, dict) and 'Earnings Date' in cal:
                raw = cal['Earnings Date']
                dt  = raw[0] if isinstance(raw, list) else raw
            else:
                continue

            if pd.notna(dt):
                days_until = (pd.Timestamp(dt) - pd.Timestamp.now()).days
                if -5 <= days_until <= days_ahead:
                    landmines[ticker] = {
                        "earnings_date":     str(pd.Timestamp(dt).date()),
                        "days_until":        days_until,
                        "action":            "BLOCK_NEW_BUYS",
                    }
        except Exception:
            continue

    if landmines:
        log_and_print(
            f"{YELLOW}[⚠️ Earnings Guard] {len(landmines)} tickers blocked near earnings: "
            f"{list(landmines.keys())}{RESET}"
        )
    return landmines


# ==========================================
# UPGRADE #6 — PORTFOLIO CONCENTRATION RISK
# ==========================================
def analyze_portfolio_concentration(portfolio, risk_matrix):
    """
    Three institutional risk checks:

    1. Sector concentration — max 35% in any single sector
       (avoids blowing up on a sector-specific shock)

    2. Pairwise correlation — flags pairs with ρ > 0.85
       (owning two 0.90-correlated stocks is not diversification)

    3. Herfindahl-Hirschman Index — measures effective bet count
       HHI = Σ(weight²); Effective N = 10000 / HHI
       A concentrated 3-stock portfolio has Effective N ≈ 3,
       a balanced 10-stock portfolio has Effective N ≈ 10.
    """
    if not portfolio.get("positions") or not risk_matrix:
        return {"status": "NO_POSITIONS", "warnings": [], "sector_exposure_pct": {}}

    warnings_list = []
    total_eq = sum(v.get('current_value', 0) for v in risk_matrix.values())
    if total_eq <= 0:
        return {"status": "NO_POSITIONS", "warnings": [], "sector_exposure_pct": {}}

    # ── Sector concentration ──────────────────────────────────────────────
    sector_map = {}
    for pos_key, data in risk_matrix.items():
        tkr = data.get('ticker', pos_key.split('_')[0])
        try:
            sector = yf.Ticker(tkr).info.get('sector', 'Unknown')
        except Exception:
            sector = 'Unknown'
        sector_map[sector] = sector_map.get(sector, 0) + data.get('current_value', 0)

    for sec, val in sector_map.items():
        pct = val / total_eq * 100
        if pct > 35:
            warnings_list.append(
                f"⚠️ SECTOR OVERWEIGHT: {sec} = {round(pct,1)}% (limit 35%)"
            )

    # ── Herfindahl-Hirschman Index ────────────────────────────────────────
    weights = [v.get('current_value', 0) / total_eq * 100 for v in risk_matrix.values()]
    hhi     = sum(w ** 2 for w in weights)
    eff_n   = 10000 / hhi if hhi > 0 else 0
    if eff_n < 5:
        warnings_list.append(
            f"⚠️ CONCENTRATED PORTFOLIO: Effective bets = {round(eff_n,1)} (minimum 5)"
        )

    # ── Pairwise correlation ──────────────────────────────────────────────
    high_corr_pairs = []
    tickers = [v.get('ticker', k.split('_')[0]) for k, v in risk_matrix.items()]
    if len(tickers) >= 2:
        try:
            px = yf.download(tickers, period="1y", auto_adjust=True, progress=False)['Close']
            if isinstance(px, pd.Series):
                px = px.to_frame()
            corr = px.pct_change().dropna().corr()
            cols = corr.columns.tolist()
            for i in range(len(cols)):
                for j in range(i + 1, len(cols)):
                    c = corr.iloc[i, j]
                    if c > 0.85:
                        high_corr_pairs.append(
                            f"{cols[i]}/{cols[j]} ρ={round(c,2)}"
                        )
            if high_corr_pairs:
                warnings_list.append(
                    f"⚠️ HIGH CORRELATION: {', '.join(high_corr_pairs)}"
                )
        except Exception:
            pass

    return {
        "status":               "WARNINGS" if warnings_list else "HEALTHY",
        "warnings":             warnings_list,
        "sector_exposure_pct":  {k: round(v / total_eq * 100, 1) for k, v in sector_map.items()},
        "effective_bet_count":  round(eff_n, 1),
        "hhi":                  round(hhi, 1),
        "high_corr_pairs":      high_corr_pairs,
    }


# ==========================================
# UPGRADE #9 — PERFORMANCE ATTRIBUTION
# ==========================================
def calculate_performance_metrics(portfolio, benchmark="SPY"):
    """
    Institutional-grade attribution vs benchmark:

    Metric          What it measures
    ──────────────  ───────────────────────────────────────────────
    Total Return    Cumulative gain/loss since first purchase
    Alpha (Jensen)  Excess return above CAPM expectation
    Beta            Market sensitivity (1.0 = moves with SPY)
    Sharpe Ratio    Return per unit of total volatility
    Sortino Ratio   Return per unit of DOWNSIDE volatility only
    Max Drawdown    Worst peak-to-trough decline (risk of ruin)
    Calmar Ratio    Ann. return / |Max Drawdown| (ruin-adjusted return)
    """
    if not portfolio.get("positions"):
        return {}

    try:
        start = min(
            pd.Timestamp(p.get("purchase_date", "2024-01-01"))
            for p in portfolio["positions"].values()
        )
        tickers = list(set(pk.split('_')[0] for pk in portfolio["positions"]))
        if not tickers:
            return {}

        px = yf.download(tickers + [benchmark], start=start, auto_adjust=True, progress=False)['Close']
        if isinstance(px, pd.Series) or benchmark not in px.columns:
            return {}

        bench_ret   = px[benchmark].pct_change().dropna()
        bench_total = (px[benchmark].iloc[-1] / px[benchmark].iloc[0] - 1) * 100

        total_cap = sum(p['allocated_capital'] for p in portfolio['positions'].values())
        if total_cap <= 0:
            return {}

        weights = {}
        for pk, p in portfolio['positions'].items():
            t = pk.split('_')[0]
            weights[t] = weights.get(t, 0) + p['allocated_capital'] / total_cap

        valid = [t for t in tickers if t in px.columns]
        if not valid:
            return {}

        port_ret = pd.Series(0.0, index=px.index)
        for t in valid:
            if t in weights:
                port_ret = port_ret + px[t].pct_change() * weights[t]

        aligned = pd.concat([port_ret, bench_ret], axis=1, join='inner').dropna()
        aligned.columns = ['portfolio', 'benchmark']
        if len(aligned) < 5:
            return {}

        RF   = 0.045   # risk-free rate
        ANN  = 252

        port_total = ((1 + aligned['portfolio']).prod() - 1) * 100
        mu_p  = aligned['portfolio'].mean() * ANN
        sig_p = aligned['portfolio'].std()  * (ANN ** 0.5)
        sharpe = (mu_p - RF) / sig_p if sig_p > 0 else 0

        down   = aligned['portfolio'][aligned['portfolio'] < RF / ANN]
        sig_dn = down.std() * (ANN ** 0.5) if len(down) > 0 else sig_p
        sortino = (mu_p - RF) / sig_dn if sig_dn > 0 else 0

        cov  = np.cov(aligned['portfolio'], aligned['benchmark'])[0, 1]
        beta = cov / aligned['benchmark'].var() if aligned['benchmark'].var() > 0 else 1.0

        mu_b  = aligned['benchmark'].mean() * ANN
        alpha = mu_p - (RF + beta * (mu_b - RF))

        cum     = (1 + aligned['portfolio']).cumprod()
        max_dd  = float(((cum - cum.cummax()) / cum.cummax()).min()) * 100
        calmar  = (mu_p - RF) / abs(max_dd / 100) if max_dd != 0 else 0

        metrics = {
            "total_return_pct":       round(port_total, 2),
            "benchmark_return_pct":   round(bench_total, 2),
            "alpha_annualized_pct":   round(alpha * 100, 2),
            "beta":                   round(beta, 3),
            "sharpe_ratio":           round(sharpe, 3),
            "sortino_ratio":          round(sortino, 3),
            "max_drawdown_pct":       round(max_dd, 2),
            "calmar_ratio":           round(calmar, 3),
            "ann_volatility_pct":     round(sig_p * 100, 2),
        }
        log_and_print(f"{GREEN}[📊 Perf] {metrics}{RESET}")
        return metrics

    except Exception as e:
        log_and_print(f"Warning: Performance calc failed: {e}")
        return {}


# ==========================================
# RISK MONITOR (with UPGRADE #7 — Trailing Stops)
# ==========================================
def evaluate_open_positions(portfolio):
    """
    Enhanced v1 monitor plus:
    - Per-position high watermark tracking
    - -25% from peak → TRIM 50% trigger
    - -35% from peak → SELL trigger
    - Fundamental quality deterioration alerts (ROE/FCF collapse)
    """
    risk_matrix = {}
    positions_value = 0
    temp_prices = {}

    log_and_print(f"{YELLOW}[📊 Audit] Evaluating portfolio structural integrity...{RESET}")

    for pos_key, pos_data in portfolio.get("positions", {}).items():
        ticker = pos_key.split('_')[0]
        try:
            cp = float(yf.Ticker(ticker).history(period="5d")['Close'].iloc[-1])
            temp_prices[pos_key] = cp
            positions_value += pos_data["shares"] * cp
        except Exception:
            temp_prices[pos_key] = pos_data["entry_price"]
            positions_value += pos_data["allocated_capital"]

    total_nav = portfolio["cash_balance"] + positions_value

    for pos_key, pos_data in portfolio.get("positions", {}).items():
        ticker = pos_key.split('_')[0]
        cp     = temp_prices.get(pos_key, pos_data["entry_price"])
        pnl    = ((cp - pos_data["entry_price"]) / pos_data["entry_price"]) * 100
        weight = (pos_data["shares"] * cp) / total_nav if total_nav > 0 else 0

        # ── UPGRADE #7: Trailing high watermark ───────────────────────────
        hwm = pos_data.get("high_watermark", pos_data["entry_price"])
        if cp > hwm:
            portfolio["positions"][pos_key]["high_watermark"] = cp
            hwm = cp
        dd_from_peak = ((hwm - cp) / hwm) * 100 if hwm > 0 else 0

        try:
            t      = yf.Ticker(ticker)
            hist_d = t.history(period="250d")
            hist_w = t.history(period="5y", interval="1wk")
            info   = t.info

            closes = hist_d['Close']
            sma50  = float(closes.iloc[-50:].mean())
            sma200 = float(closes.iloc[-200:].mean())
            mom60  = ((cp - float(closes.iloc[-60])) / float(closes.iloc[-60])) * 100

            live_rev_growth = info.get('revenueGrowth', 0)  or 0
            live_roe        = info.get('returnOnEquity', 0) or 0
            live_op_cash    = info.get('operatingCashflow', 0) or 0

            # Weekly 200 EMA + MACD
            wc         = hist_w['Close'].dropna()
            ema200w    = float(wc.ewm(span=200, adjust=False).mean().iloc[-1])
            macd_hist  = (wc.ewm(span=12, adjust=False).mean() -
                          wc.ewm(span=26, adjust=False).mean())
            signal     = macd_hist.ewm(span=9, adjust=False).mean()
            macd_bar   = macd_hist - signal
            macd_rising = float(macd_bar.iloc[-1]) > float(macd_bar.iloc[-2])

            # ── Risk status priority ladder ──────────────────────────────
            status = "✅ HEALTHY RUNNER"

            if cp < ema200w * 0.90:
                if not macd_rising:
                    status = "🚨 CRITICAL WEEKLY BREAKDOWN: >10% below 200W EMA & MACD worsening → EMERGENCY SELL"
                else:
                    status = "⚠️ DEEP DRAWDOWN + MACD BULLISH DIVERGENCE: Below 200W EMA but momentum improving → HOLD"

            elif live_rev_growth <= 0:
                status = "🔴 FUNDAMENTAL REVERSAL: Revenue growth turned negative → SELL"

            elif live_roe < 0.08 or live_op_cash <= 0:
                status = "🟠 QUALITY DETERIORATION: ROE or FCF collapsing → TRIM 50%"

            elif dd_from_peak >= 35:
                status = f"🔴 TRAILING STOP HIT: -{round(dd_from_peak,1)}% from peak → SELL"

            elif dd_from_peak >= 25:
                status = f"🟠 TRAILING STOP WARNING: -{round(dd_from_peak,1)}% from peak → TRIM 50%"

            elif cp < sma200:
                status = "🟡 STRUCTURAL CAUTION: Below 200D SMA → Review"

            elif cp < sma50 and mom60 < -12:
                status = "🟠 MOMENTUM FADING: Below 50D SMA, -12% 60D momentum → Potential Trim"

            risk_matrix[pos_key] = {
                "ticker":             ticker,
                "current_price":      round(cp, 2),
                "current_value":      round(pos_data["shares"] * cp, 2),
                "current_weight_pct": round(weight * 100, 2),
                "pnl_pct":            round(pnl, 2),
                "dd_from_peak_pct":   round(dd_from_peak, 2),
                "algo_risk_status":   status,
                "live_rev_growth_pct": round(live_rev_growth * 100, 2),
                "live_roe_pct":       round(live_roe * 100, 2),
                "ema_200w":           round(ema200w, 2),
                "macd_rising":        macd_rising,
                "buying_thesis":      pos_data.get("buying_thesis", "N/A"),
            }

        except Exception as e:
            log_and_print(f"Warning: Failed {ticker}: {e}")

    return risk_matrix, total_nav


# ==========================================
# UPGRADE #8 — MULTI-AGENT AI ARCHITECTURE
# ==========================================
#
# v1: one monolithic Gemini call doing everything
# v2: three specialized agents with strict mandates
#
#   Agent 1 (Macro Analyst)       → sets the strategic battlefield
#   Agent 2 (Risk Manager)        → reviews existing positions ONLY
#   Agent 3 (Portfolio Constructor) → selects new buys ONLY
#
# Separation of concerns prevents the AI from rationalizing
# new buys while simultaneously ignoring exit signals.
# ─────────────────────────────────────────────────────────────────────────────

def query_macro_analyst_agent(regime_data, risk_matrix):
    """AGENT 1 — Sets sector rotation directive and positioning bias."""
    prompt = f"""
You are the Chief Investment Officer at a top-tier global macro hedge fund.

QUANTITATIVE REGIME DATA:
{json.dumps(regime_data, indent=2)}

LIVE PORTFOLIO RISK SIGNALS:
{json.dumps(risk_matrix, indent=2)}

Write a 3-paragraph macro brief covering:
1. Current regime characterization with specific data references
2. Sector rotation plays (overweight / underweight) with rationale
3. Key tail risks for the next 30 days

Then output structured directives under JSON_DIRECTIVES:
{{
  "positioning_bias":       "AGGRESSIVE" | "NEUTRAL" | "DEFENSIVE",
  "sectors_to_overweight":  ["Technology"],
  "sectors_to_underweight": ["Real Estate"],
  "key_risk_flags":         ["string"],
  "max_new_pos_size_pct":   8.0
}}
"""
    try:
        r = ai_client.models.generate_content(
            model=GEMINI_MODEL,
            contents=prompt,
            config=types.GenerateContentConfig(temperature=0.10)
        )
        raw  = r.text.strip()
        body = raw.split("JSON_DIRECTIVES:")[0].strip() if "JSON_DIRECTIVES:" in raw else raw
        json_str = raw.split("JSON_DIRECTIVES:")[1].strip() if "JSON_DIRECTIVES:" in raw else "{}"
        json_str = json_str.replace("```json", "").replace("```", "").strip()
        directives = json.loads(json_str)

        log_and_print(
            f"{CYAN}[🧠 Macro Agent] Bias: {directives.get('positioning_bias')} | "
            f"OW: {directives.get('sectors_to_overweight')}{RESET}"
        )
        send_notification(f"📊 *MACRO BRIEF*\n\n{body[:800]}")
        return directives, body

    except Exception as e:
        log_and_print(f"{RED}[Macro Agent Error] {e}{RESET}")
        return {
            "positioning_bias": "NEUTRAL",
            "sectors_to_overweight": [],
            "sectors_to_underweight": [],
            "max_new_pos_size_pct": 8.0,
        }, ""


def query_risk_manager_agent(risk_matrix, concentration_analysis, performance_metrics):
    """AGENT 2 — Issues SELL/TRIM orders. Capital preservation only. Cannot issue BUYs."""
    if not risk_matrix:
        return []

    prompt = f"""
