    portfolio = load_portfolio()

    # ── PHASE 1: INTELLIGENCE GATHERING ────────────────────────────────
    universe     = get_macro_universe()
    regime       = check_enhanced_market_regime()

    # ── PHASE 2: OPPORTUNITY SCREENING ─────────────────────────────────
    buy_candidates    = run_enhanced_screener(universe)
    earnings_landmines = get_earnings_landmines(list(buy_candidates.keys()))

    # ── PHASE 3: POSITION MONITORING & RISK ANALYTICS ──────────────────
    risk_matrix, current_nav  = evaluate_open_positions(portfolio)
    concentration             = analyze_portfolio_concentration(portfolio, risk_matrix)
    performance               = calculate_performance_metrics(portfolio)

    if concentration.get("warnings"):
        for w in concentration["warnings"]:
            log_and_print(f"{YELLOW}[⚠️ Risk] {w}{RESET}")

    # ── PHASE 4: MULTI-AGENT AI DECISION PIPELINE ──────────────────────
    #   Agent 1 → Macro directive
    macro_directives, macro_commentary = query_macro_analyst_agent(regime, risk_matrix)

    #   Agent 2 → Risk/exit decisions (independent of buy side)
    risk_actions = query_risk_manager_agent(risk_matrix, concentration, performance)

    #   Agent 3 → Entry decisions (informed by macro, guarded by earnings)
    buy_orders = query_portfolio_constructor_agent(
        buy_candidates, macro_directives, regime,
        portfolio, current_nav, earnings_landmines
    )

    # ── PHASE 5: EXECUTION (sells first, then buys) ─────────────────────
    sells = consolidate_decisions([d for d in risk_actions if d.get("action") in ["SELL","TRIM"]])
    buys  = consolidate_decisions(buy_orders)

    execute_trades(sells, portfolio, buy_candidates, risk_matrix, current_nav, regime)

    portfolio = load_portfolio()   # reload after sells → updated cash
    execute_trades(buys,  portfolio, buy_candidates, risk_matrix, current_nav, regime)

    # ── PHASE 6: REPORTING ──────────────────────────────────────────────
    check_and_send_weekly_summary(portfolio, risk_matrix, current_nav, performance, concentration)

    log_and_print(f"{CYAN}{'='*56}{RESET}")
    log_and_print(f"{CYAN}        ✅ SYSTEM CYCLE COMPLETE — v2.0              {RESET}")
    log_and_print(f"{CYAN}{'='*56}{RESET}")
