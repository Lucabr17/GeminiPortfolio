def load_portfolio():
    try:
        with open("portfolio.json", "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return {
            "cash_balance": 100000.0,
            "positions": {},
            "performance_history": []   # daily NAV snapshots
        }

def save_portfolio(data):
    with open("portfolio.json", "w") as f:
        json.dump(data, f, indent=4)

