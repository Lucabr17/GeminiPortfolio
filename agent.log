def check_and_send_weekly_summary(portfolio, risk_matrix, total_nav, perf, conc):
    if "--weekly-summary" not in sys.argv and datetime.now(ZoneInfo("America/New_York")).weekday() != 4:
        return

    log_and_print(f"{YELLOW}[📊] Generating institutional end-of-week report...{RESET}")

    cash     = portfolio.get("cash_balance", 0)
    cash_pct = cash / total_nav * 100 if total_nav > 0 else 0

    holdings = ""
    for pk, data in risk_matrix.items():
        val  = data.get("current_value", 0)
        wt   = data.get("current_weight_pct", 0)
        pnl  = data.get("pnl_pct", 0)
        stat = data.get("algo_risk_status", "")
        emoji = "✅" if "HEALTHY" in stat else "⚠️"
        if val > 0:
            holdings += f"  {emoji} *{pk.split('_')[0]}*: ${round(val,2)} ({round(wt,1)}%) | PnL: {round(pnl,1)}%\n"
    if not holdings:
        holdings = "  • 100% Cash\n"

    perf_str = ""
    if perf:
        perf_str = (
            f"\n📈 *PERFORMANCE vs SPY*\n"
            f"  • Portfolio Return: {perf.get('total_return_pct','N/A')}%\n"
            f"  • SPY Return:       {perf.get('benchmark_return_pct','N/A')}%\n"
            f"  • Alpha (Ann.):     {perf.get('alpha_annualized_pct','N/A')}%\n"
            f"  • Sharpe:           {perf.get('sharpe_ratio','N/A')}\n"
            f"  • Sortino:          {perf.get('sortino_ratio','N/A')}\n"
            f"  • Max Drawdown:     {perf.get('max_drawdown_pct','N/A')}%\n"
            f"  • Calmar Ratio:     {perf.get('calmar_ratio','N/A')}\n"
            f"  • Beta:             {perf.get('beta','N/A')}\n"
        )

    risk_str = ""
    if conc.get("warnings"):
        risk_str = "\n⚠️ *RISK WARNINGS*\n" + "\n".join(f"  • {w}" for w in conc["warnings"])

    msg = (
        "🗓️ *END-OF-WEEK INSTITUTIONAL REPORT*\n"
        "======================================\n\n"
        f"💰 *NAV:*     ${round(total_nav,2)}\n"
        f"💵 *Cash:*    ${round(cash,2)} ({round(cash_pct,1)}%)\n"
        f"📈 *Equities:* ${round(total_nav-cash,2)}\n\n"
        f"📦 *Holdings:*\n{holdings}"
        f"{perf_str}"
        f"{risk_str}\n"
        "======================================\n"
        "🔄 _Next scan: Monday open_"
    )

    send_notification(msg)
    log_and_print(f"{GREEN}[📊] Weekly report delivered.{RESET}")


