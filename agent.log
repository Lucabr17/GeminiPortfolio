</section><section data-mw-section-id="6" id="mwZQ" aria-labelledby="List_of_1,000-point_milestones_by_number_of_trading_days"><div class="mw-heading mw-heading3"><h3 id="List_of_1,000-point_milestones_by_number_of_trading_days"><span id="List_of_1.2C000-point_milestones_by_number_of_trading_days" typeof="mw:FallbackId"></span>List of 1,000-point milestones by number of trading days</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Nasdaq-100&amp;action=edit&amp;section=6" title="Edit section: List of 1,000-point milestones by number of trading days"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

